{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "workers_dev": true,
  "compatibility_date": "2026-07-15",
  // Static site: Astro builds to ./dist and Cloudflare serves it as Worker assets.
  "routes": [{ "pattern": "me.underreacted.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
