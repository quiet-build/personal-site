{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "compatibility_date": "2026-07-15",
  // Static site: Astro builds to ./dist and Cloudflare serves it as Worker assets.
  // No custom domain yet — deploys to the account's *.workers.dev subdomain.
  // To attach a domain later, add a "routes" block, e.g.:
  //   "routes": [{ "pattern": "ming.example.com", "custom_domain": true }]
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
